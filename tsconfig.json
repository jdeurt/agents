{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "allowJs": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strictNullChecks": true,
    "types": ["bun"]
  },
  "include": ["**/*"],
  "exclude": ["node_modules", "dist", ".marketplace-build", ".marketplace-verify"]
}
