{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strictNullChecks": true,
    "types": ["bun"]
  },
  "include": ["scripts/**/*.ts", "plugins/engineering/**/*.ts", "plugins/engineering/**/*.mts", "eslint.config.ts"]
}
